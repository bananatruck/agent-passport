{
  "name": "agent-passport-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r --filter agent-passport build && node scripts/sync-vendor.mjs && pnpm --filter tidewater-trip-desk build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm build && node scripts/serve.mjs",
    "pin": "node packages/passport/bin/agent-passport.mjs pin",
    "check-pins": "node packages/passport/bin/agent-passport.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "playwright-core": "1.65.1"
  }
}
